# -------------------------------------------------------------
# ២. ទាញយកទិន្នន័យបន្ថែមពីអ៊ីនធឺណិត (ដាក់ Link JSON របស់អ្នកនៅទីនេះ បើមាន)
# -------------------------------------------------------------
online_url = ""  # ឧទាហរណ៍៖ "https://example.com/sensi_ios_extra.json"
if online_url:
    online_data = load_data_from_url(online_url)
    if online_data and "Replacements" in online_data:
        base_data["Replacements"].extend(online_data["Replacements"])

# -------------------------------------------------------------
# ៣. អានទិន្នន័យបន្ថែមពី Profile ផ្ទាល់ខ្លួនដែលមានស្រាប់ក្នុងម៉ាស៊ីន (Local JSON File)
# -------------------------------------------------------------
profile_file = "sensi_profile.json"  # ហ្វាល Profile របស់អ្នក
profile_data = load_data_from_file(profile_file)
if profile_data and "Replacements" in profile_data:
    base_data["Replacements"].extend(profile_data["Replacements"])

# ៤. រក្សាទុករួមបញ្ចូលគ្នាចេញជាហ្វាលចុងក្រោយសម្រាប់ Import ចូល iPhone
output_filename = "Sensi_iOS_Config.json"
with open(output_filename, "w", encoding="utf-8") as f:
    json.dump(base_data, f, ensure_ascii=False, indent=4)

print(f"ជោគជ័យ! បានបង្កើតហ្វាលឈ្មោះ '{output_filename}' ដែលមានឈ្មោះ Group 'Sensi iOS🇻🇳' រួចរាល់ហើយ។")

# សាកល្បងហៅមុខងារបញ្ជូនពាក្យបញ្ជា (Test Action Execution)
execute_command_action("[Home]")
